    "engineRestartMsg" : {
      "comment" : "Message for when the engine must restart after tapping Game Folder button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine wird nun geschlossen. Bitte starten die App neu, um die Änderungen abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The engine will now close. Please restart the app to complete changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor está a punto de cerrar. Por favor reinicie la aplicación para completar sus cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu va maintenant se fermer. Veuillez redémarrer l'application pour finaliser les modifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今、エンジンが終了しています。アプリを再起動して下さい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A engine vai ser fechada. Por favor reinicie o aplicativo para concluir as mudanças."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发动机现在将关闭。请重新启动应用程序以完成更改。"
          }
        }
      }
    },
