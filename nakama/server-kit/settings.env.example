# Copy this file to settings.env and edit it. One KEY=value per line, without
# quotes. The scripts and the window (server-control.py) read it; the window's
# Public name page writes GAME_DIR, GAME, BUILD and REGION.

# The server's id in nakama-matchmaker-server (./server.sh add <id> ...). It
# also names the services: <id>-server, <id>-caddy and <id>-duckdns.
SERVER_ID=mygame

# The title of the window and of the services.
TITLE=My Game Online

# The game folder you share with your players: set-public-host.sh writes its
# data/online/servers.json, and play-on-this-pc.sh starts the game in it.
GAME_DIR=/home/you/My Game

# Who plays together: players are only paired with the same game id, build
# and region (nakama/hosting.md, step 8). Change BUILD with every release that
# cannot play the one before it.
GAME=mygame
BUILD=mygame-1.0
REGION=us-west

# Where the programs are, when they are not in programs/ here or in PATH.
#MATCHMAKER=/home/you/server/matchmaker/bin/nakama-matchmaker-server
#CADDY=/home/you/server/caddy/caddy
