# Copy this file to settings.env and edit it. One KEY=value per line, without
# quotes. It holds what this folder's servers share; each server has its own
# settings in servers/<id>.env (add-server.sh makes them: title, game folder,
# game id, build, region and public name). The scripts and the window
# (server-control.py) read both.

# The folder's id: it names the shared services (<KIT_ID>-caddy and
# <KIT_ID>-duckdns) and the window. Lowercase letters, digits and dashes.
# Left out, add-server.sh sets it to the first server's id.
#KIT_ID=mygame

# The title of the window and of the shared services.
TITLE=My Game Online

# Where the programs are, when they are not in programs/ here or in PATH.
#MATCHMAKER=/home/you/server/matchmaker/bin/nakama-matchmaker-server
#CADDY=/home/you/server/caddy/caddy
