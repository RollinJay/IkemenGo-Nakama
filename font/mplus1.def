[FNT v2]
; FNT v2 version number.  Don't change this.
fntversion = 2,00
; Name of this font.
name = "M PLUS 1"
; Font author
author = "The M+ FONTS Project Authors"

; M PLUS 1 Regular (SIL Open Font License, see MPLUS1/OFL.txt): Latin with
; Vietnamese, Japanese kana and 5,289 kanji. The lobby's chat texts use it.
; The TrueType renderer needs the .ttf files, not the .otf ones.

[Def]
; This is a truetype font.
Type = truetype
; Size of font: width, height.  Only height is used for truetype fonts: the
; glyphs are drawn at this pixel height, then scaled (the lobby chat uses 0.3).
Size = 0,24
; Spacing between font glyphs.  Only height is used for truetype fonts.
Spacing = 0,0
; Drawing offset: x, y.
Offset = 0,0
; Filename of the font to load.
File = MPLUS1/MPLUS1-Regular.ttf
; Preferred blending mode: 0 - none, 1 - blended.
Blend = 1
